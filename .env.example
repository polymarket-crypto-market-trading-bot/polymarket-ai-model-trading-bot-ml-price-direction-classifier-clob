# KuCoin API credentials (required for live trading)
KUCOIN_API_KEY=
KUCOIN_API_SECRET=
KUCOIN_API_PASSPHRASE=

# Environment: production | sandbox
KUCOIN_ENV=production

# Trading pairs to monitor (comma-separated)
TRADING_SYMBOLS=BTC-USDT,ETH-USDT

# Whale detection thresholds
WHALE_MIN_TRADE_USDT=50000
WHALE_ORDERBOOK_WALL_USDT=100000
WHALE_COOLDOWN_MS=30000

# Copy trading settings
COPY_RATIO=0.01
MAX_POSITION_USDT=1000
MAX_DAILY_TRADES=20
MAX_SLIPPAGE_PERCENT=0.5
STOP_LOSS_PERCENT=2
TAKE_PROFIT_PERCENT=4

# Risk management
MAX_OPEN_POSITIONS=3
MIN_ACCOUNT_BALANCE_USDT=100

# Bot mode: monitor | live | paper
BOT_MODE=paper

# Logging
LOG_LEVEL=info
LOG_PRETTY=true
